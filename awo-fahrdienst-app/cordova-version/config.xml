<?xml version='1.0' encoding='utf-8'?>
<widget id="de.awo.opr.fahrdienst" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>AWO OPR Fahrdienst</name>
    <description>
        Fahrdienst-App für die AWO Ostprignitz-Ruppin mit GPS-Tracking und Nachweiserstellung
    </description>
    <author email="support@awo-opr.de" href="https://www.awo-opr.de">
        AWO Ostprignitz-Ruppin
    </author>
    
    <!-- App-Einstellungen -->
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />
    
    <!-- Android-spezifische Einstellungen -->
    <platform name="android">
        <allow-intent href="market:*" />
        
        <!-- App-Icons -->
        <icon density="ldpi" src="res/android/ldpi.png" />
        <icon density="mdpi" src="res/android/mdpi.png" />
        <icon density="hdpi" src="res/android/hdpi.png" />
        <icon density="xhdpi" src="res/android/xhdpi.png" />
        <icon density="xxhdpi" src="res/android/xxhdpi.png" />
        <icon density="xxxhdpi" src="res/android/xxxhdpi.png" />
        
        <!-- Splash Screens -->
        <splash density="land-ldpi" src="res/android/splash-land-ldpi.png" />
        <splash density="land-mdpi" src="res/android/splash-land-mdpi.png" />
        <splash density="land-hdpi" src="res/android/splash-land-hdpi.png" />
        <splash density="land-xhdpi" src="res/android/splash-land-xhdpi.png" />
        <splash density="land-xxhdpi" src="res/android/splash-land-xxhdpi.png" />
        <splash density="land-xxxhdpi" src="res/android/splash-land-xxxhdpi.png" />
        <splash density="port-ldpi" src="res/android/splash-port-ldpi.png" />
        <splash density="port-mdpi" src="res/android/splash-port-mdpi.png" />
        <splash density="port-hdpi" src="res/android/splash-port-hdpi.png" />
        <splash density="port-xhdpi" src="res/android/splash-port-xhdpi.png" />
        <splash density="port-xxhdpi" src="res/android/splash-port-xxhdpi.png" />
        <splash density="port-xxxhdpi" src="res/android/splash-port-xxxhdpi.png" />
        
        <!-- Android-Berechtigungen -->
        <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
        <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
        <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
        <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
        <uses-permission android:name="android.permission.INTERNET" />
        <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
        <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
        <uses-permission android:name="android.permission.VIBRATE" />
        <uses-permission android:name="android.permission.WAKE_LOCK" />
        
        <!-- Android-spezifische Präferenzen -->
        <preference name="android-minSdkVersion" value="22" />
        <preference name="android-targetSdkVersion" value="33" />
        <preference name="android-compileSdkVersion" value="33" />
        <preference name="GradlePluginVersion" value="7.4.2" />
        <preference name="AndroidXEnabled" value="true" />
        
        <!-- Hardware-Beschleunigung -->
        <preference name="android-hardwareAccelerated" value="true" />
        
        <!-- Backup erlauben -->
        <preference name="android-allowBackup" value="true" />
        
        <!-- Netzwerk-Sicherheit -->
        <preference name="android-usesCleartextTraffic" value="true" />
    </platform>
    
    <!-- Globale Präferenzen -->
    <preference name="Orientation" value="portrait" />
    <preference name="Fullscreen" value="false" />
    <preference name="StatusBarOverlaysWebView" value="false" />
    <preference name="StatusBarBackgroundColor" value="#2196F3" />
    <preference name="StatusBarStyle" value="lightcontent" />
    
    <!-- Splash Screen -->
    <preference name="SplashScreen" value="screen" />
    <preference name="SplashScreenDelay" value="3000" />
    <preference name="AutoHideSplashScreen" value="true" />
    <preference name="SplashShowOnlyFirstTime" value="false" />
    <preference name="FadeSplashScreen" value="true" />
    <preference name="FadeSplashScreenDuration" value="750" />
    <preference name="ShowSplashScreenSpinner" value="false" />
    
    <!-- Webview-Einstellungen -->
    <preference name="DisallowOverscroll" value="true" />
    <preference name="BackgroundColor" value="0xffffffff" />
    <preference name="HideKeyboardFormAccessoryBar" value="true" />
    <preference name="KeyboardDisplayRequiresUserAction" value="false" />
    
    <!-- Sicherheit -->
    <preference name="AllowInlineMediaPlayback" value="true" />
    <preference name="MediaPlaybackRequiresUserAction" value="false" />
    
    <!-- Plugins -->
    <plugin name="cordova-plugin-whitelist" spec="^1.3.5" />
    <plugin name="cordova-plugin-statusbar" spec="^3.0.0" />
    <plugin name="cordova-plugin-device" spec="^2.1.0" />
    <plugin name="cordova-plugin-splashscreen" spec="^6.0.2" />
    <plugin name="cordova-plugin-geolocation" spec="^4.1.0">
        <variable name="GEOLOCATION_USAGE_DESCRIPTION" value="Diese App benötigt Zugriff auf Ihren Standort für GPS-Tracking während der Fahrten." />
    </plugin>
    <plugin name="cordova-plugin-file" spec="^7.0.0" />
    <plugin name="cordova-plugin-file-transfer" spec="^1.7.1" />
    <plugin name="cordova-plugin-network-information" spec="^3.0.0" />
    <plugin name="cordova-plugin-vibration" spec="^3.1.1" />
    <plugin name="cordova-plugin-dialogs" spec="^2.0.2" />
    <plugin name="cordova-plugin-inappbrowser" spec="^5.0.0" />
    <plugin name="cordova-plugin-x-toast" spec="^2.7.3" />
    
    <!-- Content Security Policy -->
    <allow-navigation href="*" />
    
    <!-- Engine -->
    <engine name="android" spec="^11.0.0" />
</widget>

