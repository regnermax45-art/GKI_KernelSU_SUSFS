/* MaxRegner Kitchen - Ultra Modern Dark Theme */

/* Main Application Styling */
QApplication {
    background-color: #1e1e1e;
    color: #ffffff;
    font-family: "Segoe UI", "Roboto", "Arial", sans-serif;
    font-size: 9pt;
}

/* Main Window */
QMainWindow {
    background-color: #1e1e1e;
    border: none;
}

/* Central Widget */
QWidget {
    background-color: #1e1e1e;
    color: #ffffff;
    border: none;
}

/* Menu Bar */
QMenuBar {
    background-color: #2d2d2d;
    color: #ffffff;
    border: none;
    padding: 4px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 8px 12px;
    border-radius: 4px;
    margin: 2px;
}

QMenuBar::item:selected {
    background-color: #404040;
}

QMenuBar::item:pressed {
    background-color: #505050;
}

/* Menu */
QMenu {
    background-color: #2d2d2d;
    color: #ffffff;
    border: 1px solid #404040;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 24px;
    border-radius: 4px;
    margin: 1px;
}

QMenu::item:selected {
    background-color: #404040;
}

QMenu::separator {
    height: 1px;
    background-color: #404040;
    margin: 4px 8px;
}

/* Tool Bar */
QToolBar {
    background-color: #2d2d2d;
    border: none;
    padding: 4px;
    spacing: 2px;
}

QToolBar::separator {
    background-color: #404040;
    width: 1px;
    margin: 4px 2px;
}

/* Status Bar */
QStatusBar {
    background-color: #2d2d2d;
    color: #ffffff;
    border-top: 1px solid #404040;
    padding: 4px;
}

QStatusBar::item {
    border: none;
}

/* Buttons */
QPushButton {
    background-color: #404040;
    color: #ffffff;
    border: 1px solid #606060;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 500;
    min-width: 80px;
}

QPushButton:hover {
    background-color: #505050;
    border-color: #707070;
}

QPushButton:pressed {
    background-color: #353535;
    border-color: #505050;
}

QPushButton:disabled {
    background-color: #2a2a2a;
    color: #666666;
    border-color: #404040;
}

/* Primary Button */
QPushButton[class="primary"] {
    background-color: #0078d4;
    border-color: #106ebe;
}

QPushButton[class="primary"]:hover {
    background-color: #106ebe;
    border-color: #005a9e;
}

QPushButton[class="primary"]:pressed {
    background-color: #005a9e;
}

/* Success Button */
QPushButton[class="success"] {
    background-color: #107c10;
    border-color: #0e6e0e;
}

QPushButton[class="success"]:hover {
    background-color: #0e6e0e;
    border-color: #0c5d0c;
}

/* Danger Button */
QPushButton[class="danger"] {
    background-color: #d13438;
    border-color: #b52d30;
}

QPushButton[class="danger"]:hover {
    background-color: #b52d30;
    border-color: #a02628;
}

/* Line Edit */
QLineEdit {
    background-color: #2d2d2d;
    color: #ffffff;
    border: 1px solid #606060;
    border-radius: 4px;
    padding: 8px 12px;
    font-size: 9pt;
}

QLineEdit:focus {
    border-color: #0078d4;
    background-color: #353535;
}

QLineEdit:disabled {
    background-color: #1a1a1a;
    color: #666666;
    border-color: #404040;
}

/* Text Edit */
QTextEdit, QPlainTextEdit {
    background-color: #2d2d2d;
    color: #ffffff;
    border: 1px solid #606060;
    border-radius: 4px;
    padding: 8px;
    font-family: "Consolas", "Monaco", "Courier New", monospace;
    font-size: 9pt;
    line-height: 1.4;
}

QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #0078d4;
}

/* Combo Box */
QComboBox {
    background-color: #2d2d2d;
    color: #ffffff;
    border: 1px solid #606060;
    border-radius: 4px;
    padding: 8px 12px;
    min-width: 120px;
}

QComboBox:hover {
    border-color: #707070;
}

QComboBox:focus {
    border-color: #0078d4;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    image: url(data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTIiIGhlaWdodD0iOCIgdmlld0JveD0iMCAwIDEyIDgiIGZpbGw9Im5vbmUiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+CjxwYXRoIGQ9Ik0xIDFMNiA2TDExIDEiIHN0cm9rZT0iI0ZGRkZGRiIgc3Ryb2tlLXdpZHRoPSIyIiBzdHJva2UtbGluZWNhcD0icm91bmQiIHN0cm9rZS1saW5lam9pbj0icm91bmQiLz4KPC9zdmc+);
    width: 12px;
    height: 8px;
}

QComboBox QAbstractItemView {
    background-color: #2d2d2d;
    color: #ffffff;
    border: 1px solid #606060;
    border-radius: 4px;
    selection-background-color: #404040;
    outline: none;
}

/* List Widget */
QListWidget {
    background-color: #2d2d2d;
    color: #ffffff;
    border: 1px solid #606060;
    border-radius: 4px;
    padding: 4px;
    outline: none;
}

QListWidget::item {
    padding: 8px 12px;
    border-radius: 4px;
    margin: 1px;
}

QListWidget::item:selected {
    background-color: #404040;
}

QListWidget::item:hover {
    background-color: #353535;
}

/* Tree Widget */
QTreeWidget {
    background-color: #2d2d2d;
    color: #ffffff;
    border: 1px solid #606060;
    border-radius: 4px;
    outline: none;
}

QTreeWidget::item {
    padding: 4px;
    border-radius: 2px;
}

QTreeWidget::item:selected {
    background-color: #404040;
}

QTreeWidget::item:hover {
    background-color: #353535;
}

QTreeWidget::branch {
    background-color: transparent;
}

/* Table Widget */
QTableWidget {
    background-color: #2d2d2d;
    color: #ffffff;
    border: 1px solid #606060;
    border-radius: 4px;
    gridline-color: #404040;
    outline: none;
}

QTableWidget::item {
    padding: 8px;
    border: none;
}

QTableWidget::item:selected {
    background-color: #404040;
}

QHeaderView::section {
    background-color: #404040;
    color: #ffffff;
    border: none;
    padding: 8px 12px;
    font-weight: 600;
}

/* Scroll Bar */
QScrollBar:vertical {
    background-color: #2d2d2d;
    width: 12px;
    border-radius: 6px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #606060;
    border-radius: 6px;
    min-height: 20px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #707070;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: #2d2d2d;
    height: 12px;
    border-radius: 6px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #606060;
    border-radius: 6px;
    min-width: 20px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #707070;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* Progress Bar */
QProgressBar {
    background-color: #2d2d2d;
    border: 1px solid #606060;
    border-radius: 6px;
    text-align: center;
    font-weight: 500;
    height: 20px;
}

QProgressBar::chunk {
    background-color: #0078d4;
    border-radius: 5px;
    margin: 1px;
}

/* Slider */
QSlider::groove:horizontal {
    background-color: #404040;
    height: 6px;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background-color: #0078d4;
    width: 18px;
    height: 18px;
    border-radius: 9px;
    margin: -6px 0;
}

QSlider::handle:horizontal:hover {
    background-color: #106ebe;
}

/* Check Box */
QCheckBox {
    color: #ffffff;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #606060;
    border-radius: 3px;
    background-color: #2d2d2d;
}

QCheckBox::indicator:checked {
    background-color: #0078d4;
    border-color: #0078d4;
    image: url(data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTIiIGhlaWdodD0iOSIgdmlld0JveD0iMCAwIDEyIDkiIGZpbGw9Im5vbmUiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+CjxwYXRoIGQ9Ik0xIDQuNUw0LjUgOEwxMSAxIiBzdHJva2U9IiNGRkZGRkYiIHN0cm9rZS13aWR0aD0iMiIgc3Ryb2tlLWxpbmVjYXA9InJvdW5kIiBzdHJva2UtbGluZWpvaW49InJvdW5kIi8+Cjwvc3ZnPg==);
}

QCheckBox::indicator:hover {
    border-color: #707070;
}

/* Radio Button */
QRadioButton {
    color: #ffffff;
    spacing: 8px;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #606060;
    border-radius: 8px;
    background-color: #2d2d2d;
}

QRadioButton::indicator:checked {
    background-color: #0078d4;
    border-color: #0078d4;
}

QRadioButton::indicator:checked::after {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: #ffffff;
    margin: 4px;
}

/* Group Box */
QGroupBox {
    color: #ffffff;
    border: 1px solid #606060;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 8px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 8px;
    background-color: #1e1e1e;
}

/* Tab Widget */
QTabWidget::pane {
    background-color: #2d2d2d;
    border: 1px solid #606060;
    border-radius: 6px;
    margin-top: -1px;
}

QTabBar::tab {
    background-color: #404040;
    color: #ffffff;
    border: 1px solid #606060;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 8px 16px;
    margin-right: 2px;
    font-weight: 500;
}

QTabBar::tab:selected {
    background-color: #2d2d2d;
    border-color: #606060;
    border-bottom: 1px solid #2d2d2d;
}

QTabBar::tab:hover:!selected {
    background-color: #505050;
}

/* Splitter */
QSplitter::handle {
    background-color: #404040;
    border: 1px solid #606060;
}

QSplitter::handle:horizontal {
    width: 3px;
    margin: 2px 0;
}

QSplitter::handle:vertical {
    height: 3px;
    margin: 0 2px;
}

QSplitter::handle:hover {
    background-color: #0078d4;
}

/* Dock Widget */
QDockWidget {
    color: #ffffff;
    font-weight: 600;
}

QDockWidget::title {
    background-color: #404040;
    border: 1px solid #606060;
    border-radius: 4px;
    padding: 8px;
    text-align: center;
}

QDockWidget::close-button,
QDockWidget::float-button {
    background-color: #606060;
    border: 1px solid #707070;
    border-radius: 3px;
    width: 16px;
    height: 16px;
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background-color: #707070;
}

/* Tool Tip */
QToolTip {
    background-color: #404040;
    color: #ffffff;
    border: 1px solid #606060;
    border-radius: 4px;
    padding: 6px 8px;
    font-size: 8pt;
}

/* Custom Classes */
.card {
    background-color: #2d2d2d;
    border: 1px solid #606060;
    border-radius: 8px;
    padding: 16px;
    margin: 8px;
}

.card-header {
    font-size: 12pt;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid #404040;
}

.info-text {
    color: #b3b3b3;
    font-size: 8pt;
    font-style: italic;
}

.success-text {
    color: #4caf50;
    font-weight: 500;
}

.warning-text {
    color: #ff9800;
    font-weight: 500;
}

.error-text {
    color: #f44336;
    font-weight: 500;
}

.highlight {
    background-color: #404040;
    border-radius: 4px;
    padding: 2px 6px;
}

/* Animation Support */
* {
    transition: all 0.2s ease-in-out;
}

/* Responsive Design */
@media (max-width: 1200px) {
    QWidget {
        font-size: 8pt;
    }
    
    QPushButton {
        padding: 6px 12px;
        min-width: 60px;
    }
}
